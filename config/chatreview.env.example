# Copy to .chatreview/archive.env, replace placeholders, and chmod 600.

# The bundled Compose database listens on loopback port 54329.
export CHATREVIEW_DATABASE_URL='postgresql://chatreview:chatreview@127.0.0.1:54329/chatreview'

# Generate a different stable UUID on every source machine: uuidgen
export CHATREVIEW_MACHINE_ID='replace-with-one-persistent-uuid-per-machine'
export CHATREVIEW_MACHINE_NAME='workstation-name'
# export CHATREVIEW_CONTRIBUTOR='Display name'

# Built-in read-only source roots.
export CHATREVIEW_CODEX_ROOT="$HOME/.codex"
export CHATREVIEW_CLAUDE_ROOT="$HOME/.claude"
export CHATREVIEW_GEMINI_ROOT="$HOME/.gemini"
export CHATREVIEW_GIT_ROOT="$HOME/Projects"
export CHATREVIEW_ENABLE_GIT='1'

# Workload calendar timezone (IANA name). Defaults to UTC when omitted.
export CHATREVIEW_TIMEZONE='UTC'

# Worker cadence and ingestion throughput.
export CHATREVIEW_SYNC_INTERVAL='21600'
export CHATREVIEW_SYNC_WORKERS='1'
export CHATREVIEW_SYNC_BATCH_LINES='1000'

# Summaries are optional. Recommended self-hosted path: an OpenAI-compatible
# Qwen endpoint served by llama.cpp, vLLM, Ollama, or another local gateway.
export CHATREVIEW_ENABLE_SUMMARIES='0'
# export CHATREVIEW_SUMMARY_PROVIDER='openai-compatible'
# export CHATREVIEW_SUMMARY_MODEL='Qwen/Qwen3-30B-A3B-Instruct-2507'
# export CHATREVIEW_SUMMARY_BASE_URL='http://127.0.0.1:8000/v1'

# Hosted OpenAI-compatible providers use the same adapter. Keep keys only here.
# export CHATREVIEW_SUMMARY_PROVIDER='openai-compatible'
# export CHATREVIEW_SUMMARY_MODEL='provider/model-name'
# export CHATREVIEW_SUMMARY_BASE_URL='https://provider.example/v1'
# export CHATREVIEW_SUMMARY_API_KEY='replace-me'
# export CHATREVIEW_SUMMARY_HEADERS_JSON='{"HTTP-Referer":"https://your-site.example"}'

# Native Anthropic Messages support.
# export CHATREVIEW_SUMMARY_PROVIDER='anthropic'
# export CHATREVIEW_SUMMARY_MODEL='claude-model-name'
# export CHATREVIEW_SUMMARY_API_KEY='replace-me'

# Native OpenAI Responses support, including API models available to your account.
# export CHATREVIEW_SUMMARY_PROVIDER='openai-responses'
# export CHATREVIEW_SUMMARY_MODEL='account-model-name'
# export CHATREVIEW_SUMMARY_BASE_URL='https://api.openai.com/v1'
# export CHATREVIEW_SUMMARY_API_KEY='replace-me'

# A custom provider can return an object implementing the SummaryProvider protocol.
# export CHATREVIEW_SUMMARY_PROVIDER='plugin'
# export CHATREVIEW_SUMMARY_PLUGIN='my_package.chatreview:build_provider'

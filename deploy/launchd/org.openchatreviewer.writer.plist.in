<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.openchatreviewer.writer</string>
  <key>ProgramArguments</key>
  <array>
    <string>@REPO_ROOT@/scripts/chatreview-sync.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@REPO_ROOT@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>CHATREVIEW_ENV_FILE</key>
    <string>@REPO_ROOT@/.chatreview/archive.env</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>10800</integer>
  <key>StandardOutPath</key>
  <string>@REPO_ROOT@/.chatreview/logs/writer.log</string>
  <key>StandardErrorPath</key>
  <string>@REPO_ROOT@/.chatreview/logs/writer-error.log</string>
</dict>
</plist>

[Unit]
Description=Open Chat Reviewer sync and derivation worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
Environment=CHATREVIEW_ENV_FILE=@REPO_ROOT@/.chatreview/archive.env
ExecStart=@REPO_ROOT@/scripts/chatreview-worker.sh
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
